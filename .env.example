# =============================================================================
# Universal AI Form Assistant — environment configuration
# Copy to .env and fill in. Generate secrets with:  npm run gen:secrets
# NEVER commit a real .env file.
# =============================================================================

NODE_ENV=development
# Public URL of the web app (used for CSRF origin checks and email links)
APP_URL=http://localhost:3000

# --- PostgreSQL (self-hosted; replaces Supabase) ------------------------------
# Owner/system connection: runs migrations, auth lookups, background jobs. Bypasses RLS.
DATABASE_URL=postgres://ufa_owner:CHANGE_ME_OWNER_PASSWORD@localhost:54320/ufa
# Runtime connection as the restricted ufa_app role. RLS is enforced on it.
DATABASE_APP_URL=postgres://ufa_app:CHANGE_ME_APP_PASSWORD@localhost:54320/ufa
# Password the migration runner assigns to the ufa_app role (must match DATABASE_APP_URL)
DB_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
DB_POOL_MAX=10

# --- Auth & encryption ---------------------------------------------------------
# >= 32 random chars. Used for OTP hashing and signed file URLs.
AUTH_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_TTL_DAYS=30
# AES-256-GCM keys for sensitive profile fields: "id:base64(32 bytes)", first key encrypts.
# Rotate by prepending a new key:  k2:<new>,k1:<old>
# LOSING THIS KEY MEANS LOSING ACCESS TO ENCRYPTED DATA — back it up separately from DB backups.
DATA_ENCRYPTION_KEYS=k1:CHANGE_ME_BASE64_32_BYTES

# --- Email (SMTP) ----------------------------------------------------------------
# Hostinger mail: smtp.hostinger.com, port 465, SMTP_SECURE=true
# Local dev: leave SMTP_HOST empty to print emails (OTP codes, reset links) to the server console,
# or use Mailpit from docker-compose.dev.yml: SMTP_HOST=localhost SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Universal AI Form Assistant <no-reply@example.com>"

# --- File storage (local disk on the VPS; S3-compatible driver later) -----------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_MB=10
# Documents are processed (antivirus -> OCR -> extraction) in the background inside the web app.
DOCUMENT_WORKER_ENABLED=true
OCR_TIMEOUT_MS=120000
# Optional ClamAV daemon. Empty = scanning skipped (type/size/PDF safety checks still apply).
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- AI (phases 5-6; not used yet) ---------------------------------------------
LOCAL_AI_ENABLED=false
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_MODEL=qwen2.5:7b-instruct
# Optional: embeddings for semantic field matching (ollama pull nomic-embed-text). Empty = off.
LOCAL_AI_EMBED_MODEL=
LOCAL_AI_API_KEY=
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Cost control for the cloud fallback (fields, not requests). Only labels/types are ever sent.
GEMINI_DAILY_FIELD_LIMIT=200
GEMINI_MAX_FIELDS_PER_REQUEST=40
AI_CACHE_TTL_DAYS=30
AI_CONFIDENCE_THRESHOLD=0.90
AI_FALLBACK_THRESHOLD=0.70
# Which models may run: local_only (never cloud), hybrid (local/rules first, Gemini as fallback; default), cloud_enabled (reserved).
AI_ROUTING_MODE=hybrid

# Persistent task engine runner (AI browser Phase 1). Tasks are leased, so several web containers are safe.
TASKS_RUNNER_ENABLED=true
# "Write email" drafts by Gemini per user per day; a ready template is used after that.
COMPOSE_DAILY_LIMIT=30

# Gmail (AI browser Phase 5). Google Cloud Console: enable the Gmail API, OAuth consent screen with scopes
# gmail.readonly (+ gmail.compose for drafts), OAuth client "Web application" with the redirect URI below.
# Empty = Gmail is off (the dashboard shows setup steps). Tokens are stored encrypted, never sent to browsers.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Default: ${APP_URL}/api/integrations/gmail/callback
GMAIL_OAUTH_REDIRECT_URI=
# WhatsApp Business Platform (business numbers only): detected, not used yet. Personal chats use exports.
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_TOKEN=
# Imported WhatsApp chats are deleted after this many days (per chat changeable).
WHATSAPP_RETENTION_DAYS=30
# Conversation summaries / reply drafts by cloud AI per user per day.
MESSAGES_AI_DAILY_LIMIT=50

# Behind Caddy/Nginx on the VPS, trust X-Forwarded-For for client IPs.
TRUST_PROXY=true

# --- One-off: first admin (npm run db:create-admin) -----------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Learning engine (phase 9): shared WEBSITE/GLOBAL knowledge is created only when at least
# this many *different* users agree (minimums: 2 and 3). Structure only, never values.
LEARNING_ENABLED=true
LEARNING_INTERVAL_MINUTES=30
LEARNING_WEBSITE_MIN_USERS=2
LEARNING_GLOBAL_MIN_USERS=3

# Hardening (phase 13)
# Admin features need two-step verification. Keep true in production.
ADMIN_REQUIRE_MFA=true
# Days between "delete my account" and permanent erasure (1-90).
ACCOUNT_DELETION_GRACE_DAYS=30
# Bearer token for GET /api/metrics (Prometheus). Empty = endpoint disabled (404). openssl rand -hex 32
METRICS_TOKEN=

# Phase 6: local companion (a program on the user's own computer that connects OUT to this server).
# Off by default: pairing and device requests answer 404 until enabled. No port is opened on any computer.
COMPANION_ENABLED=false
# Cloud AI calls per user per day for plans, local-file summaries and command reviews (only with consent).
COMPANION_AI_DAILY_LIMIT=30
