{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "test-form",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/test-form/server.mjs"],
      "port": 4000
    },
    {
      "name": "web-3001",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-w", "@ufa/web", "next", "dev", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "test-form-3001",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/test-form/server.mjs"],
      "env": { "TEST_FORM_API": "http://localhost:3001" },
      "port": 4000
    }
  ]
}
